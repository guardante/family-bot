# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Ключ API Z.AI (new-api.z.ai -> API Keys)
GLM_API_KEY=your_api_key_here

# Базовый URL GLM API.
# Международная платформа: https://api.z.ai/api/paas/v4
# Китайская (bigmodel.cn):  https://open.bigmodel.cn/api/paas/v4
GLM_BASE_URL=https://api.z.ai/api/paas/v4

# Модель. Любая доступная flash-модель, например glm-4.5-flash
GLM_MODEL=glm-4.5-flash

# Модель с поддержкой картинок (распознавание текста на фото)
GLM_VISION_MODEL=glm-4.5v

# Белый список Telegram ID через запятую.
# Свой ID можно узнать у @userinfobot.
# ПУСТО = бот открыт для всех.
ALLOWED_TELEGRAM_IDS=123456789,987654321

# Путь к файлу базы SQLite. В docker compose задаётся в docker-compose.yml (/data/nadia.db).
# SQLITE_PATH=data/nadia.db

# Не нужно менять: DATABASE_URL больше не используется (база теперь SQLite).
